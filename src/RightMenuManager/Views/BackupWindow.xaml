<Window x:Class="RightMenuManager.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RightMenuManager.Models"
        Title="备份与恢复"
        Width="820"
        Height="600"
        MinWidth="700"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,2,18">
            <StackPanel>
                <TextBlock Text="备份与恢复"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="删除菜单项前会自动导出 .reg 备份。恢复会把备份写回原注册表位置。"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button Content="打开备份文件夹"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="打开备份文件夹"
                    Click="OnOpenRootFolderClick" />
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource AccentSoftBrush}"
                CornerRadius="9"
                Padding="12,9"
                Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="13"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="恢复操作会覆盖同名的现有注册表项。建议在恢复后重启资源管理器。"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="BackupList"
                     AutomationProperties.Name="备份列表"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:BackupEntry}">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="16,13">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38"
                                        CornerRadius="10"
                                        Background="#F4F6FA"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE81C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0,16,0"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Style="{StaticResource BadgeBorder}"
                                                Margin="8,0,0,0"
                                                Background="#F2F4F9">
                                            <TextBlock Text="{Binding Kind}"
                                                       Style="{StaticResource BadgeText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding RegistryPath}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"
                                               ToolTip="{Binding RegistryPath}" />
                                    <TextBlock Text="{Binding CreatedText}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="恢复"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="14,6"
                                            AutomationProperties.Name="恢复备份"
                                            AutomationProperties.AutomationId="RestoreBackupButton"
                                            Tag="{Binding}"
                                            Click="OnRestoreClick"
                                            Margin="0,0,8,0" />
                                    <Button Content="文件夹"
                                            Style="{StaticResource SecondaryButton}"
                                            Padding="12,6"
                                            AutomationProperties.Name="打开备份文件夹"
                                            Tag="{Binding}"
                                            Click="OnOpenEntryFolderClick"
                                            Margin="0,0,8,0" />
                                    <Button Style="{StaticResource DangerButton}"
                                            Width="32" Height="32"
                                            Padding="0"
                                            AutomationProperties.Name="删除备份"
                                            Tag="{Binding}"
                                            Click="OnDeleteBackupClick"
                                            ToolTip="删除这份备份">
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="54" Height="54"
                        CornerRadius="16"
                        Background="#F4F6FA"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE81C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="还没有备份"
                           FontSize="13.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,14,0,0" />
                <TextBlock Text="在首页删除菜单项时，会自动在这里生成可恢复的备份。"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="3" Margin="2,14,2,0">
            <TextBlock x:Name="FooterText"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
            <Button Content="关闭"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"
                    Padding="18,7"
                    AutomationProperties.Name="关闭"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
